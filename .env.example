# Copy to apps/api/.env for local development; never commit actual secrets.
DATABASE_URL=postgresql://studio:studio_dev_only@localhost:5432/studio?schema=public
PORT=3001
WS_PORT=3002
HOST=0.0.0.0
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGIN=http://localhost:5173

# Local SeaweedFS S3 object storage (docker compose up -d objectstore).
# AWS SDK clients still use S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY.
# Demo credentials are for local Codespaces only.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=localstudio
S3_SECRET_KEY=localstudio_dev_only
S3_BUCKET=studio-media

# Optional local open-model storyboarding. Install Ollama separately and pull a model.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b

# Optional LOCAL image generation (requires a running ComfyUI and a compatible checkpoint).
# localhost is evaluated from the machine hosting Fastify, not your home PC when using Codespaces.
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=<installed-checkpoint-name>.safetensors

