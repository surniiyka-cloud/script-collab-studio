# Copy to apps/api/.env for local development; never commit actual secrets.
DATABASE_URL=postgresql://studio:studio_dev_only@localhost:5432/studio?schema=public
PORT=3001
WS_PORT=3002
HOST=0.0.0.0
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGIN=http://localhost:5173

# Local MinIO (docker compose up -d minio). Never use these demo credentials publicly.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=localstudio
S3_SECRET_KEY=localstudio_dev_only
S3_BUCKET=studio-media
