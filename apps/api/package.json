{
  "name": "@studio/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "pnpm test:logic",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "test:logic": "node --experimental-strip-types --test tests/graph.test.ts tests/security.test.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "4.7.1",
    "@hocuspocus/extension-database": "4.7.1",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "argon2": "0.44.0",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "yjs": "13.6.27",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pg": "8.15.5",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
