generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum NodeKind {
  SCENE
  SHOT
  LOCATION
  CHARACTER
  AUDIO
}

enum EdgeKind {
  SEQUENCE
  DEPENDENCY
  ALTERNATIVE
}

enum ShotType {
  WIDE
  MEDIUM
  CLOSE_UP
  EXTREME_CLOSE_UP
  OTS
  POV
  INSERT
  OTHER
}

enum MediaKind {
  IMAGE
  AUDIO
}

enum AIJobKind {
  BREAKDOWN
  STORYBOARD
  LOGIC_CHECK
  CHAT
}

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  displayName  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  owned        Project[]       @relation("OwnedProjects")
  memberships  ProjectMember[]
  comments     Comment[]
  aiJobs       AIJob[]
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  description String?
  ownerId     String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("OwnedProjects", fields: [ownerId], references: [id])
  members     ProjectMember[]
  scripts     Script[]
  nodes       Node[]
  edges       Edge[]
  media       MediaAsset[]
  locations   Location[]
  characters  Character[]
  comments    Comment[]
  jobs        AIJob[]
  yDocs       YDocState[]
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
}

model Script {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  acts      Act[]
  scenes    Scene[]
  @@index([projectId])
}

model Act {
  id       String  @id @default(uuid()) @db.Uuid
  scriptId String  @db.Uuid
  title    String
  sortKey  String
  script   Script  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  scenes   Scene[]
  @@unique([scriptId, sortKey])
}

model Scene {
  id         String     @id @default(uuid()) @db.Uuid
  scriptId   String     @db.Uuid
  actId      String     @db.Uuid
  title      String
  synopsis   String?
  sortKey    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  script     Script     @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  act        Act        @relation(fields: [actId], references: [id], onDelete: Cascade)
  nodes      Node[]
  mediaLinks MediaLink[]
  revisions  Revision[]
  comments   Comment[]
  @@unique([actId, sortKey])
  @@index([scriptId])
}

model Node {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  sceneId     String?   @db.Uuid
  kind        NodeKind
  title       String
  description String?
  shotType    ShotType?
  durationMs  Int?
  positionX   Float     @default(0)
  positionY   Float     @default(0)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene       Scene?    @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  outgoing    Edge[]    @relation("EdgeSource")
  incoming    Edge[]    @relation("EdgeTarget")
  mediaLinks  MediaLink[]
  comments    Comment[]
  @@index([projectId, kind])
  @@index([sceneId])
}

model Edge {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  sourceNodeId String   @db.Uuid
  targetNodeId String   @db.Uuid
  kind         EdgeKind
  label        String?
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source       Node     @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target       Node     @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  @@unique([sourceNodeId, targetNodeId, kind])
  @@index([projectId, kind])
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  description String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model Character {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  description String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model MediaAsset {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  kind      MediaKind
  objectKey String      @unique
  filename  String
  mimeType  String
  sizeBytes BigInt
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links     MediaLink[]
}

model MediaLink {
  id      String      @id @default(uuid()) @db.Uuid
  assetId String      @db.Uuid
  sceneId String?     @db.Uuid
  nodeId  String?     @db.Uuid
  asset   MediaAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scene   Scene?      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  node    Node?       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  @@index([sceneId])
  @@index([nodeId])
}

model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  authorId   String    @db.Uuid
  sceneId    String?   @db.Uuid
  nodeId     String?   @db.Uuid
  body       String
  anchor     Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id])
  scene      Scene?    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  node       Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model AIJob {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  kind      AIJobKind
  status    AIJobStatus @default(QUEUED)
  result    Json?
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])
}

model YDocState {
  documentName String   @id
  projectId    String   @db.Uuid
  update       Bytes
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model Revision {
  id        String   @id @default(uuid()) @db.Uuid
  sceneId   String   @db.Uuid
  snapshot  Bytes
  label     String?
  createdAt DateTime @default(now())
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  @@index([sceneId, createdAt])
}
